{
  "$schema": "secrets_allowlist_v1",
  "description": "Reviewed exclusions and allowed placeholder patterns for check_secrets.py",
  "excluded_paths": [
    ".git",
    ".runtime",
    ".venv",
    ".mypy_cache",
    ".pytest_cache",
    "__pycache__",
    "build",
    "dist"
  ],
  "excluded_extensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".wav",
    ".mp3",
    ".mp4",
    ".ico",
    ".whl",
    ".tar.gz",
    ".pyc"
  ],
  "allowed_patterns": [
    "YOUR_TELEGRAM_BOT_TOKEN",
    "your_telegram_bot_token",
    "your-api-key",
    "your_api_key_here",
    "\\[redacted\\]",
    "0000000000:AA[a-zA-Z0-9_-]{33}",
    "123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_1234567",
    "AKIAIOSFODNN7EXAMPLE",
    "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
    "ghp_000000000000000000000000000000000000",
    "xoxb-YOUR_SLACK_TOKEN"
  ],
  "path_specific_allowlists": {
    "tests/unit/test_failure_record.py": [
      "fake-structured-key-secret"
    ]
  }
}
