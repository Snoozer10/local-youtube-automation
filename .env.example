# .env.example
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
BROWSER_TYPE=chrome
# (Add the remaining key-value structures here with blank or placeholder values)


# --- Global Browser & Remote Debugging (utils.py) ---
BROWSER_TYPE=chrome                     # chrome | opera
CDP_PORT=9222                           # Chrome DevTools Protocol port
CHROME_USER_DATA_DIR=C:\ChromeDebugProfile
OPERA_USER_DATA_DIR=C:\OperaDebugProfile

# --- Account Rotation & Failover System ---
SWITCH_ACCOUNTS_ENABLED=true            # Auto-rotate Google profiles on block/fail
ACTIVE_PROFILE_INDEX=2                  # 1 = Default, 2 = Profile 1, 3 = Profile 2, etc.
FAILOVER_RETRY_LIMIT=3                  # Max retries before rotating account profile
TELEGRAM_NOTIFY_PER_STEP=false          # run_agency: push alert per completed pipeline step

# --- Gemini Model Selections (Web App) ---
SCRIPT_BREAKER_MODEL=Flash              # Model for breaking raw transcript into paragraphs
SCRIPT_TRANSLATOR_MODEL=Pro             # Model for translation & transcreation
VOICE_GENERATOR_MODEL=Flash             # Model for TTS script breakdown & prompt prep
IMAGE_PLANNER_MODEL=Flash               # Model for storyboard roadmap planning
REFINE_MODEL=Flash                      # Model for script refinement / persona tuning
THUMBNAIL_MODEL=Pro                     # Model for YouTube thumbnail prompt creation

# --- Stage 1: YouTube Scraper & Transcreation (automate_all.py) ---
CAPTION_LANGUAGES=en,es,ar,fr,de,pt,it  # Language fallback list for YouTube captions
GEMINI_BREAKDOWN_TIMEOUT=180            # Max wait time (seconds) for paragraph breaking
GEMINI_TRANSLATION_TIMEOUT=120          # Max wait time (seconds) per paragraph translation
ENABLE_ACADEMIC_SAFETY_FALLBACK=true    # Re-frame flagged paragraphs automatically

# --- Stage 2: Script Refinement (refine_script.py) ---
REFINE_PERSONA=Cairo Hype-Man           # Dialect persona / voice tone
REFINE_MAX_SLANG_PER_SENTENCE=2         # Constraint on slang frequency
REFINE_PARAGRAPH_TIMEOUT=300            # Max wait time (seconds) per paragraph refinement

# --- Stage 3: Voice Generation & TTS Synthesis (generate_voice.py) ---
TTS_MODEL=gemini-2.5-pro-preview-tts   # Google AI Studio TTS Model
TTS_VOICE_NAME=Achird                  # Target voice (Achird, Puck, Fenrir, Aoede, etc.)
TTS_TEMPERATURE=1.1                    # Voice expressiveness / variability (0.0 to 2.0)
TTS_PROACTIVE_RELOAD_INTERVAL=40       # Refresh AI Studio tab every N synthesized chapters
TTS_SYNTHESIS_TIMEOUT=300              # Max synthesis wait time (seconds) per chapter
TTS_DOWNLOAD_TIMEOUT=15                # Max download wait time (seconds)

# --- Stage 4: Visual Generation Engine (script vs flow) ---
IMAGE_GENERATOR_TYPE=flow               # script | flow
IMAGE_RESET_LOOP_LIMIT=100              # Refresh browser session every N rendered images

# --- Stage 4A: Google Flow Image Generator (flow_image_generator.py) ---
FLOW_IMAGE_MODEL=Nano Banana 2 Lite     # Nano Banana 2 | Nano Banana 2 Lite | Imagen 3
FLOW_IMAGE_COUNT=1x                     # 1x | x2 | x3 | x4
FLOW_ASPECT_RATIO=16:9                  # 16:9 | 9:16 | 1:1 | 4:3
FLOW_DISABLE_AGENT=true                 # Turn Google Flow AI Agent OFF
FLOW_CHUNK_SIZE=15                      # Script line chunk size for roadmap planning
FLOW_RENDER_TIMEOUT=180                 # Max wait time (seconds) for an image card render
FLOW_STALL_TIMEOUT=120                  # Max freeze time (seconds) before forcing tab reload

# --- Stage 4B: Script Image Generator (script_image_generator.py) ---
SCRIPT_IMAGE_CHUNK_SIZE=5               # Script chunk size for storyboard prompt generation
SCRIPT_IMAGE_PLANNING_TIMEOUT=240       # Max wait time (seconds) per storyboard chunk
SCRIPT_IMAGE_RENDER_TIMEOUT=90          # Max wait time (seconds) per Gemini image render

# --- Pipeline Orchestration Customizations (run_agency.py) ---
# true  = Execute refine_script.py sequentially during the pipeline.
# false = Skip refine_script.py entirely (runs directly from final_output.txt).
ENABLE_REFINE_SCRIPT=true

# Determine processing order for Audacity voice polishing:
# false = Execute automate_audacity.py first on chapters, then stitch_chapters.py (Default).
# true  = Execute stitch_chapters.py first to create a master track, then run automate_audacity.py on it.
FLIP_AUDACITY_ORDER=false

# Select the Speech-To-Text transcription engine script:
# faster_whisper = Executes faster_whisper_transcribe_audio.py (Recommended for local speed/accuracy).
# hard_whisper   = Executes transcribe_audio.py (Legacy native whisper engine).
WHISPER_ENGINE=faster_whisper